{
  // Typecheck domain for what tsconfig.json's `include: ["src"]` leaves dark: the vitest tests, the
  // scripts they share with the repo root (scripts/decline-census.ts) and vite.config.ts. Chained
  // in the `build` script so no file ships type-unchecked.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src", "test", "scripts", "vite.config.ts"]
}
