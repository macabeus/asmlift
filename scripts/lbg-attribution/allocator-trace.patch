--- a/gcc/stmt.c
+++ b/gcc/stmt.c
@@ -3287,6 +3287,23 @@
 /* Generate RTL for the automatic variable declaration DECL.
    (Other kinds of declarations are simply ignored if seen here.)  */
 
+static tree lbg_saved_decls[4096];
+static int lbg_saved_decl_count;
+void
+lbg_dump_named_homes ()
+{
+  int n;
+  if (!getenv ("LBG_ALLOC_TRACE")) return;
+  for (n = 0; n < lbg_saved_decl_count; n++)
+    {
+      tree d = lbg_saved_decls[n];
+      fprintf (stderr, "LBG_NAMED_HOME %s rtl=",
+               DECL_NAME (d) ? IDENTIFIER_POINTER (DECL_NAME (d)) : "<anon>");
+      print_rtl_single (stderr, DECL_RTL (d));
+    }
+  lbg_saved_decl_count = 0;
+}
