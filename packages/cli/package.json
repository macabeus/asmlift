{
  "name": "@asmlift/cli",
  "version": "0.5.0",
  "license": "MIT",
  "type": "module",
  "description": "The asmlift command line: decompile one function to C/Pascal from the terminal",
  "bin": {
    "asmlift": "./dist/asmlift.mjs"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@asmlift/core": "workspace:^",
    "@gba-kit/debug-info": "^0.5.0",
    "objdiff-wasm": "3.8.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@asmlift/toolchains": "workspace:*",
    "esbuild": "^0.28.1"
  },
  "files": [
    "dist",
    "src"
  ]
}
