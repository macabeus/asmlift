{
  "name": "@asmlift/cli",
  "version": "0.9.0",
  "license": "MIT",
  "type": "module",
  "description": "The asmlift command line: decompile one function to C/Pascal from the terminal",
  "bin": {
    "asmlift": "./dist/asmlift.mjs"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@asmlift/core": "workspace:^",
    "@gba-kit/debug-info": "^0.5.0",
    "@match-kit/compiler": "0.1.0",
    "@match-kit/decomp-yaml": "0.1.0",
    "@match-kit/scoring": "0.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@asmlift/toolchains": "workspace:*",
    "esbuild": "^0.28.1"
  },
  "files": [
    "dist",
    "src"
  ]
}
