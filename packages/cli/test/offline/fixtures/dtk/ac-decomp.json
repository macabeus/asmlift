      "scratch": {
        "platform": "gc_wii",
        "compiler": "mwcc_242_81",
        "c_flags": "-nodefaults -proc gekko -align powerpc -enum int -multibyte -char unsigned -fp hardware -Cpp_exceptions off -pragma \"cats off\" -pragma \"warn_notinlined off\" -maxerrors 1 -nosyspath -DVERSION=0 -sym on -DDEBUG=0 -DNDEBUG -d _LANGUAGE_C -d F3DEX_GBI_2 -d MUST_MATCH -O4,s -sdata 0 -sdata2 0 -inline on -lang=c",
        "ctx_path": "build/GAFE01_00/src/boot.ctx",
        "build_ctx": true
      },
      "metadata": {
        "complete": true,
        "reverse_fn_order": false,
        "source_path": "src/static/boot.c",
        "progress_categories": ["dol", "game"],
        "auto_generated": false
      }
    },
    {
      "name": "foresta/executor",
      "target_path": "build/GAFE01_00/foresta/obj/executor.o",
      "base_path": "build/GAFE01_00/src/executor.o",
