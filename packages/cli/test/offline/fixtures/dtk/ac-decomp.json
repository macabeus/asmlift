        "compiler": "mwcc_242_81",
        "c_flags": "-nodefaults -proc gekko -align powerpc -enum int -multibyte -char unsigned -fp hardware -Cpp_exceptions off -pragma \"cats off\" -pragma \"warn_notinlined off\" -maxerrors 1 -nosyspath -DVERSION=0 -sym on -DDEBUG=0 -DNDEBUG -d _LANGUAGE_C -d F3DEX_GBI_2 -d MUST_MATCH -sdata 0 -sdata2 0 -d IS_REL -requireprotos -sym on -O4,s -lang=c",
        "ctx_path": "build/GAFE01_00/src/executor.ctx",
